# Force LF line endings for all text files
# Prevents dart format --set-exit-if-changed failures on Windows CI
* text=auto eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.zip binary
*.apk binary
*.aab binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary

# SafeServer systemd 服务单元文件
#
# 安装方法：
#   1. 构建二进制（Go server）：
#        cd /opt/safenotes/server/go
#        go build -o /usr/local/bin/safeserver .
#      或复制 Node.js 脚本：
#        cp -r /opt/safenotes/server/nodejs /opt/safenotes-server
#
#   2. 复制本文件到 systemd 目录：
#        sudo cp safeserver.service /etc/systemd/system/
#
#   3. 编辑配置（至少改 token 和 dataDir）：
#        sudo $EDITOR /etc/systemd/system/safeserver.service
#
#   4. 创建数据目录（如果配置的 dataDir 不存在）：
#        sudo mkdir -p /var/lib/safenotes
#        sudo chown safenotes:safenotes /var/lib/safenotes
#
#   5. 创建专用用户（推荐，不用 root 跑）：
#        sudo useradd -r -s /usr/sbin/nologin safenotes
#
#   6. 启用并启动：
#        sudo systemctl daemon-reload
#        sudo systemctl enable safeserver
#        sudo systemctl start safeserver
#
#   7. 查看状态和日志：
#        sudo systemctl status safeserver
#        sudo journalctl -u safeserver -f
#
# 如果用 Node.js server，把 ExecStart 改为：
#   ExecStart=/usr/bin/node /opt/safenotes-server/server.js --port 4080 --data /var/lib/safenotes --token YOUR_TOKEN

[Unit]
Description=SafeNotes Sync Server (SafeServer v2.1)
Documentation=https://github.com/your-org/safenotes/docs/server-api-spec.md
After=network.target
Wants=network-online.target

[Service]
Type=simple

# 专用用户（安全：不用 root 运行）
User=safenotes
Group=safenotes

# 二进制路径和数据目录
ExecStart=/usr/local/bin/safeserver \
    -addr :4080 \
    -data /var/lib/safenotes \
    -token change-me-to-a-strong-token \
    -rate-limit 10
# 如用配置文件：ExecStart=/usr/local/bin/safeserver -config /etc/safenotes/config.json

# 工作目录
WorkingDirectory=/var/lib/safenotes

# 重启策略
Restart=on-failure
RestartSec=5s

# 资源限制（防内存泄漏撑爆系统）
MemoryMax=256M
LimitNOFILE=4096

# 安全加固
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/safenotes

# 日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=safeserver

[Install]
WantedBy=multi-user.target
